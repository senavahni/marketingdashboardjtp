# ==================================================================
# Marketing Dashboard — konfigurasi tunggal (backend + frontend)
# Salin ke .env lalu isi. Buat secret dengan: openssl rand -base64 48
# Variabel berawalan VITE_ terekspos ke browser: JANGAN isi secret di sana.
# ==================================================================

# ---------- Umum ----------
NODE_ENV=development
# URL frontend (CORS, link di notifikasi & payload MCP). Boleh dipisah koma.
APP_URL=http://localhost:5173
# URL publik backend (dipakai menyusun callback webhook untuk MCP Server)
PUBLIC_API_URL=http://localhost:3000

# ---------- Backend ----------
PORT=3000

# Database: isi DATABASE_URL ATAU POSTGRES_*
# DATABASE_URL=postgresql://user:pass@localhost:5432/marketing_dashboard
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketing_dashboard

# Redis (rate limit, antrian BullMQ, Socket.IO adapter) — isi REDIS_URL ATAU REDIS_*
# REDIS_URL=redis://user:password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# MCP Server (Project 2 / Mock MCP)
MCP_SERVER_URL=http://localhost:4100/mcp
MCP_SERVER_API_KEY=
MCP_WEBHOOK_SECRET=
MCP_WEBHOOK_SECRET_PREVIOUS=
MCP_SERVICE_TOKEN=
MCP_CALL_TIMEOUT_MS=15000
MCP_ESTIMATION_TIMEOUT_MS=30000
MCP_DISPATCH_MAX_ATTEMPTS=5
AGENT_RUN_TIMEOUT_MINUTES=120

# Lain-lain
RUN_WORKERS=true
RATE_LIMIT_ENABLED=true
FEATURE_AI_PROMPT_BLOCK=false
SWAGGER_ENABLED=true
LOG_LEVEL=debug
SEED_DEMO_PASSWORD=Demo12345!

# ---------- Frontend (Vite) ----------
# Port dev server Vite & target proxy /api, /socket.io ke backend
FRONTEND_PORT=5173
VITE_API_URL=/api/v1
VITE_WS_PATH=/socket.io
VITE_APP_ENV=local
VITE_FEATURE_AI_PROMPT_BLOCK=false

# ---------- Docker (docker compose) ----------
# Postgres & Redis TIDAK dijalankan di compose; container backend memakai server yang sudah ada di mesin host
# (mis. container postgres_db & redis_secure) lewat host.docker.internal. Port & kredensial diambil dari POSTGRES_* / REDIS_* di atas.
DOCKER_POSTGRES_HOST=host.docker.internal
DOCKER_REDIS_HOST=host.docker.internal
# Port web (nginx: frontend + proxy ke backend). Hanya port ini yang diekspos.
DOCKER_WEB_PORT=8088
