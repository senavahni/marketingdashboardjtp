# ============================================================
# Backend Modul 1 — salin ke backend/.env lalu isi nilainya.
# Variabel POSTGRES_* juga dibaca dari ../.env (root project) jika tidak ada di sini.
# Buat secret: openssl rand -base64 48
# ============================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# --- Database: isi DATABASE_URL ATAU POSTGRES_* ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/matrika_dashboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=matrika_dashboard
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# --- Redis (rate limit, queue BullMQ, Socket.IO adapter) ---
# Redis bawaan docker-compose backend: redis://localhost:6380
# Redis dengan ACL user: redis://<user>:<password>@localhost:6379
REDIS_URL=redis://localhost:6380

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- MCP Server (Project 2 / Mock MCP) ---
MCP_SERVER_URL=http://localhost:4100/mcp
MCP_SERVER_API_KEY=
MCP_WEBHOOK_SECRET=
MCP_WEBHOOK_SECRET_PREVIOUS=
MCP_SERVICE_TOKEN=
MCP_CALL_TIMEOUT_MS=15000
MCP_ESTIMATION_TIMEOUT_MS=30000
MCP_DISPATCH_MAX_ATTEMPTS=5
AGENT_RUN_TIMEOUT_MINUTES=120

# --- Lain-lain ---
RUN_WORKERS=true
RATE_LIMIT_ENABLED=true
FEATURE_AI_PROMPT_BLOCK=false
SWAGGER_ENABLED=true
LOG_LEVEL=debug
SEED_DEMO_PASSWORD=Demo12345!
