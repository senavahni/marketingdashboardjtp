// Prisma schema Modul 1 — sumber kebenaran: DDL di Documentation/modul1/M1_TASK_001_INFRA_SECURITY_DB.md
// Fitur yang tidak bisa diekspresikan Prisma (CHECK constraint, partial index, kolom generated
// `document_blocks.search_vector`, extension citext) ditulis manual di file migrasi SQL.
// Nama field = nama kolom (snake_case) agar konsisten dengan kontrak API.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum workspace_role {
  owner
  admin
  member
  viewer
}

enum task_status {
  todo
  in_progress
  in_review
  done
}

enum task_priority {
  none
  low
  medium
  high
  urgent
}

enum actor_type {
  user
  agent
  system
}

enum agent_work_status {
  idle
  queued
  thinking
  working
  completed
  failed
}

enum agent_run_trigger {
  assignment
  mention
  prompt_block
}

enum agent_run_status {
  queued
  dispatched
  running
  completed
  failed
  cancelled
}

enum web_report_period_type {
  monthly
  quarterly
  yearly
  custom
}

enum entity_type {
  workspace
  project
  task
  block
  comment
  agent
  member
}

enum intel_job_status {
  queued
  collecting
  analyzing
  indexing
  completed
  failed
  cancelling
  cancelled
  // Kontrak 1.3 (m4_market_intel): job kind baru
  running
  awaiting_review
  paused
}

enum intel_stage {
  collect
  analyze
  index
}

enum intel_stage_status {
  pending
  running
  completed
  skipped
  failed
  cancelled
}

enum mission_source {
  intel_job
  manual
}

enum mission_approval {
  auto
  review
}

enum mission_status {
  waiting_research
  planning
  awaiting_review
  scheduled
  running
  paused
  completed
  failed
  cancelled
}

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique @db.Citext
  username      String    @unique @db.Citext
  display_name  String    @db.VarChar(100)
  password_hash String
  avatar_url    String?
  is_active     Boolean   @default(true)
  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  refresh_tokens      refresh_tokens[]
  owned_workspaces    workspaces[]          @relation("workspace_owner")
  memberships         workspace_members[]
  agents_created      agents[]              @relation("agent_creator")
  projects_created    projects[]            @relation("project_creator")
  assigned_tasks      tasks[]               @relation("task_assignee_user")
  comments            comments[]            @relation("comment_author_user")
  notifications       notifications[]
  dispatched_runs     agent_runs[]          @relation("run_dispatcher")
  web_reports_created web_report_sessions[] @relation("web_report_creator")
  web_reports_updated web_report_sessions[] @relation("web_report_updater")
  intel_jobs_created intel_jobs[]          @relation("intel_job_creator")
  intel_stage_defaults_updated intel_stage_defaults[] @relation("intel_stage_default_updater")
  missions_created    agent_missions[]      @relation("mission_creator")
  products_created    products[]            @relation("product_creator")
  opportunities_owned opportunities[]       @relation("opportunity_owner")
  actions_created     marketing_actions[]   @relation("marketing_action_creator")
  strategies_created  strategy_docs[]       @relation("strategy_doc_creator")
  contents_edited     content_items[]       @relation("content_item_editor")
  approvals_decided   approvals[]           @relation("approval_decider")
  uploads             upload_refs[]         @relation("upload_uploader")
  saved_views         saved_views[]         @relation("saved_view_owner")
}

model refresh_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  family_id   String    @db.Uuid
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  replaced_by String?   @db.Uuid
  user_agent  String?
  ip_address  String?   @db.Inet
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user        users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  replacement refresh_tokens?  @relation("token_rotation", fields: [replaced_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replaces    refresh_tokens[] @relation("token_rotation")

  @@index([user_id], map: "refresh_tokens_user_idx")
  @@index([family_id], map: "refresh_tokens_family_idx")
}

model workspaces {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(100)
  owner_id   String    @db.Uuid
  timezone   String    @default("Asia/Jakarta") @db.VarChar(64)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  owner         users                 @relation("workspace_owner", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members       workspace_members[]
  agents        agents[]
  projects      projects[]
  activity_logs activity_logs[]
  notifications notifications[]
  agent_runs    agent_runs[]
  web_reports   web_report_sessions[]
  intel_jobs    intel_jobs[]
  intel_stage_defaults intel_stage_defaults[]
  missions      agent_missions[]
  products          products[]
  opportunities     opportunities[]
  marketing_actions marketing_actions[]
  strategy_docs     strategy_docs[]
  content_items     content_items[]
  approvals         approvals[]
  upload_refs       upload_refs[]
  saved_views       saved_views[]
}

model workspace_members {
  workspace_id String         @db.Uuid
  user_id      String         @db.Uuid
  role         workspace_role @default(member)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      users      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, user_id])
  @@index([user_id], map: "workspace_members_user_idx")
}

model agents {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String    @db.Uuid
  name          String    @db.VarChar(100)
  handle        String    @db.Citext
  mcp_agent_key String    @db.VarChar(100)
  description   String?
  avatar_url    String?
  is_active     Boolean   @default(true)
  created_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  workspace      workspaces   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator        users?       @relation("agent_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigned_tasks tasks[]      @relation("task_assignee_agent")
  comments       comments[]   @relation("comment_author_agent")
  agent_runs     agent_runs[]
  intel_job_stages intel_job_stages[]
  intel_stage_defaults intel_stage_defaults[]
  missions       agent_missions[]
}

model projects {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  title        String    @db.VarChar(200)
  description  String?
  icon         String?   @db.VarChar(16)
  created_by   String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  workspace     workspaces        @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator       users?            @relation("project_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks         tasks[]
  blocks        document_blocks[]
  comments      comments[]
  activity_logs activity_logs[]
  notifications notifications[]
  agent_runs    agent_runs[]
  missions      agent_missions[]
}

model tasks {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String            @db.Uuid
  parent_task_id    String?           @db.Uuid
  depth             Int               @default(1) @db.SmallInt
  title             String            @db.VarChar(500)
  status            task_status       @default(todo)
  priority          task_priority     @default(none)
  assignee_type     actor_type?
  assignee_user_id  String?           @db.Uuid
  assignee_agent_id String?           @db.Uuid
  start_date        DateTime?         @db.Date
  end_date          DateTime?         @db.Date
  is_milestone      Boolean           @default(false)
  tags              String[]          @default([])
  order_index       Int               @default(0)
  agent_status      agent_work_status @default(idle)
  created_by_type   actor_type        @default(user)
  created_by_id     String?           @db.Uuid
  completed_at      DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)

  project        projects          @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent         tasks?            @relation("task_tree", fields: [parent_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       tasks[]           @relation("task_tree")
  assignee_user  users?            @relation("task_assignee_user", fields: [assignee_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee_agent agents?           @relation("task_assignee_agent", fields: [assignee_agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blocks         document_blocks[]
  agent_runs     agent_runs[]
  mission_root   agent_missions?   @relation("mission_root_task")
  marketing_actions marketing_actions[] @relation("marketing_action_task")
  content_items     content_items[]     @relation("content_item_task")

  @@index([project_id, status, order_index], map: "tasks_project_idx")
  @@index([parent_task_id], map: "tasks_parent_idx")
  @@index([project_id, start_date], map: "tasks_timeline_idx")
  @@index([assignee_user_id], map: "tasks_assignee_user_idx")
  @@index([assignee_agent_id], map: "tasks_assignee_agent_idx")
  @@index([tags], map: "tasks_tags_idx", type: Gin)
}

model document_blocks {
  id                  String     @id @db.Uuid
  project_id          String     @db.Uuid
  task_id             String?    @db.Uuid
  parent_block_id     String?    @db.Uuid
  block_type          String     @db.VarChar(32)
  content_json        Json       @default("{}")
  plain_text          String     @default("")
  order_index         Int
  version             Int        @default(1)
  last_edited_by_type actor_type @default(user)
  last_edited_by_id   String?    @db.Uuid
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?  @db.Timestamptz(6)
  // search_vector tsvector GENERATED (dibuat di migrasi SQL, tidak dimodelkan)

  project  projects          @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task     tasks?            @relation(fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent   document_blocks?  @relation("block_tree", fields: [parent_block_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children document_blocks[] @relation("block_tree")
}

model comments {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id        String      @db.Uuid
  entity_type       entity_type
  entity_id         String      @db.Uuid
  parent_comment_id String?     @db.Uuid
  author_type       actor_type
  author_user_id    String?     @db.Uuid
  author_agent_id   String?     @db.Uuid
  content           String
  mentions          Json        @default("[]")
  edited_at         DateTime?   @db.Timestamptz(6)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?   @db.Timestamptz(6)

  project      projects   @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent       comments?  @relation("comment_thread", fields: [parent_comment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies      comments[] @relation("comment_thread")
  author_user  users?     @relation("comment_author_user", fields: [author_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  author_agent agents?    @relation("comment_author_agent", fields: [author_agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model activity_logs {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String      @db.Uuid
  project_id    String?     @db.Uuid
  entity_type   entity_type
  entity_id     String      @db.Uuid
  action        String      @db.VarChar(64)
  actor_type    actor_type
  actor_id      String?     @db.Uuid
  metadata_json Json        @default("{}")
  created_at    DateTime    @default(now()) @db.Timestamptz(6)

  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project   projects?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, created_at(sort: Desc)], map: "activity_project_idx")
  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "activity_entity_idx")
}

model notifications {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String       @db.Uuid
  workspace_id String       @db.Uuid
  type         String       @db.VarChar(48)
  title        String       @db.VarChar(200)
  body         String?
  project_id   String?      @db.Uuid
  entity_type  entity_type?
  entity_id    String?      @db.Uuid
  actor_type   actor_type?
  actor_id     String?      @db.Uuid
  read_at      DateTime?    @db.Timestamptz(6)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)

  user      users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project   projects?  @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "notifications_user_idx")
}

model agent_runs {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id   String            @db.Uuid
  project_id     String            @db.Uuid
  task_id        String?           @db.Uuid
  agent_id       String            @db.Uuid
  trigger        agent_run_trigger
  trigger_ref_id String?           @db.Uuid
  status         agent_run_status  @default(queued)
  mcp_run_id     String?           @db.VarChar(200)
  dispatched_by  String?           @db.Uuid
  attempts       Int               @default(0) @db.SmallInt
  last_error     Json?
  last_event_at  DateTime?         @db.Timestamptz(6)
  started_at     DateTime?         @db.Timestamptz(6)
  completed_at   DateTime?         @db.Timestamptz(6)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  workspace  workspaces           @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project    projects             @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task       tasks?               @relation(fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent      agents               @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispatcher users?               @relation("run_dispatcher", fields: [dispatched_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events     mcp_webhook_events[]
}

model mcp_webhook_events {
  event_id     String    @id @db.Uuid
  run_id       String?   @db.Uuid
  job_id       String?   @db.Uuid
  event_type   String    @db.VarChar(64)
  status       String    @default("processing") @db.VarChar(16)
  error        Json?
  received_at  DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)

  run agent_runs? @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intel_job intel_jobs? @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model intel_jobs {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id         String           @db.Uuid
  title                String           @db.VarChar(150)
  status               intel_job_status @default(queued)
  spec                 Json
  sources              String[]
  confirm_cost         Boolean          @default(false)
  requested_by_name    String           @default("") @db.VarChar(100)
  estimate             Json?
  mcp_job_id           String?          @unique @db.VarChar(32)
  last_event_sequence  Int              @default(0)
  total_items          Int?
  items_handle         String?          @db.VarChar(32)
  items_expire_at      DateTime?        @db.Timestamptz(6)
  cost                 Json?
  error                Json?
  retry_of_job_id      String?          @db.Uuid
  created_by           String?          @db.Uuid
  started_at           DateTime?        @db.Timestamptz(6)
  finished_at          DateTime?        @db.Timestamptz(6)
  insight_pending      Boolean          @default(false)
  terminal_notified_at DateTime?        @db.Timestamptz(6)
  // Kontrak 1.3: null = job sosial Modul 3 (kontrak 1.2); tahap kind baru disimpan di stage_view (bukan intel_job_stages)
  kind                 String?          @db.VarChar(32)
  llm_assist           Boolean          @default(false)
  budget_usd           Float?
  pause                Json?
  stage_view           Json?
  result_summary       Json?
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?        @db.Timestamptz(6)

  workspace     workspaces             @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator       users?                 @relation("intel_job_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  retry_of      intel_jobs?            @relation("intel_job_retry", fields: [retry_of_job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  retries       intel_jobs[]           @relation("intel_job_retry")
  stages        intel_job_stages[]
  insight       intel_insights?
  webhook_events mcp_webhook_events[]
  mission       agent_missions?
  strategy_docs strategy_docs[]        @relation("strategy_doc_job")
  approvals     approvals[]            @relation("approval_job")

  @@index([workspace_id, created_at(sort: Desc)], map: "intel_jobs_ws_idx")
  @@index([status, updated_at], map: "intel_jobs_active_idx")
}

model intel_job_stages {
  job_id         String             @db.Uuid
  stage          intel_stage
  agent_id       String             @db.Uuid
  agent_key      String             @db.VarChar(100)
  status         intel_stage_status @default(pending)
  progress_done  Int                @default(0)
  progress_total Int?
  stats          Json?
  error          Json?
  started_at     DateTime?          @db.Timestamptz(6)
  finished_at    DateTime?          @db.Timestamptz(6)

  job   intel_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade)
  agent agents     @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([job_id, stage])
}

model intel_insights {
  job_id          String   @id @db.Uuid
  summary_md      String?
  recommendations Json     @default("[]")
  sentiment       Json?
  trends          Json?
  volume_by_day   Json?
  google_trends   Json?
  partial         Boolean  @default(false)
  warnings        Json     @default("[]")
  generated_at    DateTime @default(now()) @db.Timestamptz(6)

  job intel_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade)
}

model intel_stage_defaults {
  workspace_id String      @db.Uuid
  stage         intel_stage
  agent_id      String      @db.Uuid
  updated_by    String?     @db.Uuid
  updated_at    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  agent     agents     @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater   users?     @relation("intel_stage_default_updater", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspace_id, stage])
}

// ===== Modul 2: Laporan Performa Website (M2_TASK_001) =====
// CHECK constraint & partial index ditulis manual di migrasi SQL.
model web_report_sessions {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id     String                 @db.Uuid
  title            String                 @db.VarChar(150)
  period_type      web_report_period_type @default(monthly)
  period_start     DateTime               @db.Date
  period_end       DateTime               @db.Date
  visitors         Int
  leads            Int
  sales_count      Int
  revenue          Decimal                @db.Decimal(18, 2)
  cost_maintenance Decimal                @default(0) @db.Decimal(18, 2)
  cost_ads         Decimal                @default(0) @db.Decimal(18, 2)
  notes            String?
  results          Json
  formula_version  Int                    @db.SmallInt
  version          Int                    @default(1)
  created_by       String?                @db.Uuid
  updated_by       String?                @db.Uuid
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?              @db.Timestamptz(6)

  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator   users?     @relation("web_report_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater   users?     @relation("web_report_updater", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Misi agent (M3_TASK_013/014): rencana task + subtask di bawah task induk misi.
model agent_missions {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id          String           @db.Uuid
  project_id            String           @db.Uuid
  agent_id              String           @db.Uuid
  source                mission_source
  intel_job_id          String?          @unique(map: "agent_missions_intel_job_key") @db.Uuid
  title                 String           @db.VarChar(150)
  instruction           String
  start_date            DateTime         @db.Date
  end_date              DateTime         @db.Date
  approval_mode         mission_approval @default(auto)
  status                mission_status   @default(planning)
  plan                  Json?
  plan_revision         Int              @default(0)
  materialized_revision Int?
  feedback              String?
  error                 Json?
  root_task_id          String?          @unique(map: "agent_missions_root_task_key") @db.Uuid
  cost_usd              Float            @default(0)
  planning_started_at   DateTime?        @db.Timestamptz(6)
  execution_enabled     Boolean          @default(true)
  max_runs              Int              @default(10)
  runs_dispatched       Int              @default(0)
  task_map              Json?
  completed_at          DateTime?        @db.Timestamptz(6)
  budget_usd            Float?
  runs_cost_usd         Float            @default(0)
  last_reschedule_on    DateTime?        @db.Date
  created_by            String?          @db.Uuid
  created_at            DateTime         @default(now()) @db.Timestamptz(6)
  updated_at            DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at            DateTime?        @db.Timestamptz(6)

  workspace workspaces  @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project   projects    @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent     agents      @relation(fields: [agent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intel_job intel_jobs? @relation(fields: [intel_job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  root_task tasks?      @relation("mission_root_task", fields: [root_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator   users?      @relation("mission_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspace_id, created_at(sort: Desc)], map: "agent_missions_ws_idx")
  @@index([status, updated_at], map: "agent_missions_status_idx")
}

// ===== DSH-V1-01: m4_market_intel (Marketing Intelligence v1.0.0) =====
// Dashboard menyimpan data yang DIKURASI MANUSIA (V1-K3); data mesin (perusahaan, kontak, skor, KB) ada di MCP.
// Kontak personal TIDAK disimpan di sini. CHECK constraint, partial unique index & view read model `mcp_products_v`
// ditulis manual di migrasi SQL 20261109000000_m4_market_intel.

enum product_status {
  draft
  active
  archived
}

enum opportunity_status {
  new
  qualified
  contacted
  meeting
  proposal
  won
  lost
  dropped
}

enum opportunity_priority {
  high
  medium
  low
}

enum marketing_action_status {
  planned
  in_progress
  done
  cancelled
}

enum strategy_status {
  draft
  in_review
  approved
  rejected
}

enum content_platform {
  instagram
  tiktok
  linkedin
  x
  threads
}

enum content_status {
  draft
  approved
  rejected
  scheduled
  published
}

enum approval_subject {
  product_analysis
  keyword_set
  strategy
  content_batch
  knowledge_card
  doctrine
  contact_batch
  import_review
  mission_plan
}

enum approval_status {
  pending
  approved
  rejected
  revise
}

enum upload_kind {
  pdf
  xlsx
  csv
}

enum upload_purpose {
  book
  brand
  import
}

model products {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String         @db.Uuid
  name                String         @db.VarChar(150)
  slug                String         @db.VarChar(160)
  category            String?        @db.VarChar(100)
  description         String?
  value_proposition   String?
  target_notes        String?
  price_range         String?        @db.VarChar(100)
  deal_value_estimate Decimal?       @db.Decimal(18, 2)
  status              product_status @default(draft)
  created_by          String?        @db.Uuid
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?      @db.Timestamptz(6)

  workspace     workspaces         @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator       users?             @relation("product_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  features      product_features[]
  opportunities opportunities[]
  strategy_docs strategy_docs[]

  @@index([workspace_id, status], map: "products_ws_status_idx")
}

model product_features {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String   @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  benefit     String?
  order_index Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, order_index], map: "product_features_product_idx")
}

model opportunities {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id        String                @db.Uuid
  product_id          String                @db.Uuid
  mcp_company_id      String                @db.Uuid
  company_name_cache  String                @db.VarChar(300)
  latest_score        Decimal?              @db.Decimal(5, 2)
  priority            opportunity_priority?
  score_model_version String?               @db.VarChar(32)
  status              opportunity_status    @default(new)
  owner_user_id       String?               @db.Uuid
  next_action_at      DateTime?             @db.Timestamptz(6)
  notes               String?
  created_by          String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)

  workspace workspaces           @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product   products             @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner     users?               @relation("opportunity_owner", fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events    opportunity_events[]
  actions   marketing_actions[]

  @@unique([workspace_id, product_id, mcp_company_id], map: "opportunities_ws_product_company_key")
  @@index([workspace_id, status, updated_at(sort: Desc)], map: "opportunities_ws_status_idx")
}

model opportunity_events {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunity_id String              @db.Uuid
  event_type     String              @db.VarChar(32)
  from_status    opportunity_status?
  to_status      opportunity_status?
  payload        Json                @default("{}")
  actor_type     actor_type
  actor_id       String?             @db.Uuid
  created_at     DateTime            @default(now()) @db.Timestamptz(6)

  opportunity opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  @@index([opportunity_id, created_at(sort: Desc)], map: "opportunity_events_opp_idx")
}

model marketing_actions {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String                  @db.Uuid
  opportunity_id  String?                 @db.Uuid
  strategy_doc_id String?                 @db.Uuid
  content_item_id String?                 @db.Uuid
  title           String                  @db.VarChar(200)
  channel         String                  @db.VarChar(48)
  status          marketing_action_status @default(planned)
  task_id         String?                 @db.Uuid
  result          String?
  created_by      String?                 @db.Uuid
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  workspace    workspaces     @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity  opportunities? @relation(fields: [opportunity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  strategy_doc strategy_docs? @relation(fields: [strategy_doc_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content_item content_items? @relation(fields: [content_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task         tasks?         @relation("marketing_action_task", fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator      users?         @relation("marketing_action_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspace_id, status], map: "marketing_actions_ws_idx")
}

model strategy_docs {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String          @db.Uuid
  product_id    String          @db.Uuid
  intel_job_id  String?         @db.Uuid
  mcp_report_id String?         @db.VarChar(32)
  title         String          @db.VarChar(200)
  version       Int             @default(1)
  status        strategy_status @default(draft)
  created_by    String?         @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?       @db.Timestamptz(6)

  workspace     workspaces          @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       products            @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intel_job     intel_jobs?         @relation("strategy_doc_job", fields: [intel_job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator       users?              @relation("strategy_doc_creator", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content_items content_items[]
  actions       marketing_actions[]

  @@index([workspace_id, product_id, created_at(sort: Desc)], map: "strategy_docs_ws_product_idx")
}

model content_items {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id    String           @db.Uuid
  strategy_doc_id String           @db.Uuid
  mcp_batch_id    String?          @db.VarChar(32)
  mcp_item_ref    String?          @db.VarChar(32)
  platform        content_platform
  format          String           @db.VarChar(32)
  pillar          String           @db.VarChar(100)
  funnel_stage    String           @db.VarChar(32)
  segment         String?          @db.VarChar(100)
  hook            String
  caption         String
  cta             String           @db.VarChar(200)
  hashtags        String[]         @default([])
  visual_brief    String           @default("")
  framework_refs  Json             @default("[]")
  insight_refs    Json             @default("[]")
  eval_score      Float?
  eval_reason     String?
  status          content_status   @default(draft)
  scheduled_at    DateTime?        @db.Timestamptz(6)
  published_url   String?
  task_id         String?          @db.Uuid
  version         Int              @default(1)
  edited_by       String?          @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?        @db.Timestamptz(6)

  workspace    workspaces          @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  strategy_doc strategy_docs       @relation(fields: [strategy_doc_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task         tasks?              @relation("content_item_task", fields: [task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  editor       users?              @relation("content_item_editor", fields: [edited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actions      marketing_actions[]

  @@unique([workspace_id, mcp_item_ref], map: "content_items_ws_item_ref_key")
  @@index([workspace_id, status, scheduled_at], map: "content_items_ws_status_idx")
  @@index([strategy_doc_id], map: "content_items_strategy_idx")
}

model approvals {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id       String           @db.Uuid
  subject_type       approval_subject
  subject_ref        String           @db.VarChar(64)
  intel_job_id       String?          @db.Uuid
  mcp_review_id      String?          @unique(map: "approvals_mcp_review_key") @db.VarChar(16)
  summary            String?
  non_blocking       Boolean          @default(false)
  status             approval_status  @default(pending)
  requested_by_agent String?          @db.VarChar(100)
  decided_by         String?          @db.Uuid
  decided_at         DateTime?        @db.Timestamptz(6)
  comment            String?
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  workspace workspaces  @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intel_job intel_jobs? @relation("approval_job", fields: [intel_job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decider   users?      @relation("approval_decider", fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspace_id, status, created_at(sort: Desc)], map: "approvals_ws_status_idx")
}

model upload_refs {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id  String         @db.Uuid
  kind          upload_kind
  mcp_upload_id String         @unique(map: "upload_refs_mcp_upload_key") @db.VarChar(16)
  filename      String         @db.VarChar(255)
  size          BigInt
  sha256        String?        @db.Char(64)
  uploaded_by   String?        @db.Uuid
  purpose       upload_purpose
  status_cache  String         @default("stored") @db.VarChar(24)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploader  users?     @relation("upload_uploader", fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspace_id, purpose, created_at(sort: Desc)], map: "upload_refs_ws_idx")
}

model saved_views {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String   @db.Uuid
  user_id      String   @db.Uuid
  page         String   @db.VarChar(48)
  name         String   @db.VarChar(100)
  filters      Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      users      @relation("saved_view_owner", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id, page, name], map: "saved_views_owner_page_name_key")
}
